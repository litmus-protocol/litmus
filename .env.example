# Root .env, used by the scripts in /scripts (pnpm setup:check, pnpm associate <ROLE>).
# Copy to .env and fill in. Never commit .env. All accounts are Hedera TESTNET, ECDSA keys (build plan §4.3, P0).

# Network
HEDERA_RPC_URL=https://testnet.hashio.io/api
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
X402_FACILITATOR_URL=https://x402.org/facilitator
OG_ROUTER_BASE_URL=https://router-api.0g.ai/v1

# Hedera account ids (0.0.x), checked by pnpm setup:check
DEPLOYER_ACCOUNT_ID=
OPERATOR_ACCOUNT_ID=
RUNNER_ACCOUNT_ID=
TREASURY_ACCOUNT_ID=
WARDEN_DEMO_ACCOUNT_ID=
BREAKER_HUMAN_ACCOUNT_ID=
# Optional until P5 (breaker bot) is built
BOT_HEDERA_ACCOUNT_ID=

# Private keys (hex, secret). Used by pnpm associate <ROLE> and later phases.
DEPLOYER_PRIVATE_KEY=
OPERATOR_PRIVATE_KEY=
RUNNER_PRIVATE_KEY=
TREASURY_PRIVATE_KEY=
WARDEN_DEMO_PRIVATE_KEY=
BREAKER_HUMAN_PRIVATE_KEY=
BOT_PRIVATE_KEY=

# 0G Router API key for the runner (secret, sk-...). setup:check sends one tiny chat request with it.
OG_API_KEY=
