# Runner (build plan §9, §15). The runner also reads ../../.env and ../../../.env, so a shared .env works.

# Network: bind to localhost (or a private network only). Never expose the runner publicly.
RUNNER_PORT=8788
RUNNER_HOST=127.0.0.1
# Shared with the gateway only. 32+ random characters: openssl rand -hex 32
RUNNER_TOKEN=
RUNNER_DATA_DIR=./data
# AES-256 key for the secret store, 64 hex chars: openssl rand -hex 32. Changing it makes stored secrets unreadable.
RUNNER_SECRETS_KEY=
# ECDSA key of the RUNNER account (the contract's runner role). Secret.
RUNNER_PRIVATE_KEY=

# Chain
ARENA_DEPLOYMENT=demo
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Inference: the 0G Compute Router (OpenAI-compatible).
OG_ROUTER_BASE_URL=https://router-api.0g.ai/v1
OG_API_KEY=
RUNNER_ALLOWED_MODELS=0gm-1.0-35b-a3b
# Developing without a 0G key? Point the same variables at a local Ollama model instead:
#   OG_ROUTER_BASE_URL=http://localhost:11434/v1
#   OG_API_KEY=ollama
#   RUNNER_ALLOWED_MODELS=qwen2.5:7b
# The 0G-only extras (verify_tee, X-0G-Provider-Sort) are sent only to 0G hosts.

# Optional non-0G fallback, used only after 0G answers 402/429/503. Keep false for the demo (D18).
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Test only (scenario E7): delay at the start of each run. Refused when NODE_ENV=production.
RUN_DELAY_MS=0
NODE_ENV=development
