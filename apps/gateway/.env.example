# Gateway env (build plan §15). The start script also reads ../../.env and ../../../.env, so the shared
# root .env usually covers everything; set gateway-only overrides here. Never commit the real .env.

# Which DefectArena deployment to use: demo (15-min window) or prod (8 h). Addresses come from
# packages/shared/src/deployments.json.
ARENA_DEPLOYMENT=demo

GATEWAY_PORT=8787
# SQLite file lives at $GATEWAY_DATA_DIR/defect.db (persistent volume on Railway)
GATEWAY_DATA_DIR=./data
# Public base URL of this gateway (x402 "resource" URL). Defaults to http://localhost:$GATEWAY_PORT
GATEWAY_PUBLIC_URL=

# Operator: deposits fees, refunds, voids, cancels, closes, posts log hashes; x402 payTo account (secret key)
OPERATOR_PRIVATE_KEY=
OPERATOR_ACCOUNT_ID=

# x402 facilitator (free, no key). Backup: https://api.testnet.blocky402.com
X402_FACILITATOR_URL=https://x402.org/facilitator

# Runner (private service) and its shared bearer token (secret, 32+ chars)
RUNNER_URL=http://127.0.0.1:8788
RUNNER_TOKEN=

# Allowed models come from the live 0G Router catalog (GET /models + /providers, 5 min cache): tool-capable chat
# models served by an on-chain 0G provider. This list is the fallback while the Router is unreachable, and the
# whole list when OG_CATALOG=off (e.g. a local Ollama runner). Must match the runner's list.
# OG_ROUTER_BASE_URL=https://router-api.0g.ai/v1
# OG_CATALOG=off
RUNNER_ALLOWED_MODELS=0gm-1.0-35b-a3b

# Canary rounds: 900 in prod, 180 in demo (default follows ARENA_DEPLOYMENT)
CANARY_INTERVAL_SEC=

# Comma-separated origins allowed by CORS (the web app)
WEB_ORIGIN=http://localhost:3000

# Public base URL of the web app, e.g. https://defect.example.com. ERC-8004 feedback writes
# <SITE_URL>/contests/<id> on chain permanently as its endpoint, so it is separate from WEB_ORIGIN.
# Unset: no ERC-8004 feedback is posted (contests are unaffected). Non-https or localhost: posted, with a warning.
SITE_URL=

HEDERA_RPC_URL=https://testnet.hashio.io/api
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# Test-funds faucet (POST /faucet): FAUCET_HBAR once per address (creates the Hedera account for a
# new EVM address), then FAUCET_USDC once the account has enabled USDC. It runs only with a key of its
# own: FAUCET_PRIVATE_KEY (ECDSA, secret) of a separate account funded with HBAR and USDC, never the
# operator key. FAUCET_ENABLED=false turns it off even with a key.
# Limits, per rolling 24 h: FAUCET_DAILY_CAP grants in total (HBAR and USDC each count) and
# FAUCET_PER_IP_DAILY new addresses per client IP (0 = off). Behind a reverse proxy the client IP comes
# from X-Forwarded-For: set TRUSTED_PROXY_HOPS to the number of proxies (1 on Railway), otherwise every
# request looks like it comes from the proxy.
# PRIVY_APP_ID + PRIVY_VERIFICATION_KEY (Privy dashboard → App settings; the PEM may use literal \n)
# make the faucet require a Privy login, one funded address per Privy user. Recommended for any public
# deployment; without them anyone can script requests for fresh addresses until the daily cap is gone.
FAUCET_PRIVATE_KEY=
FAUCET_HBAR=5
FAUCET_USDC=1
FAUCET_DAILY_CAP=100
FAUCET_PER_IP_DAILY=3
TRUSTED_PROXY_HOPS=0
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=

# Scripts (seed:demo, send:message)
GATEWAY_URL=http://localhost:8787
WARDEN_DEMO_PRIVATE_KEY=
BREAKER_HUMAN_ACCOUNT_ID=
BREAKER_HUMAN_PRIVATE_KEY=

NODE_ENV=development

# Auto-attest (OFF by default, event-driven: fired when a contest is finalized, plus once at startup): the gateway runs the real Chainlink CRE
# auditor (`cre workflow simulate auditor --broadcast`) and its result is written to DefectAttestations on Sepolia.
# Needs: the cre CLI installed, `bun install` run in workflows/auditor/auditor, and CRE_ETH_PRIVATE_KEY (64 hex chars)
# funded with Sepolia ETH. Each attestation is one Sepolia transaction from that key.
# CRE_AUTO_ATTEST=true
# CRE_ETH_PRIVATE_KEY=<64 hex chars>
# CRE_BIN=/path/to/cre            # default: ~/.cre/bin/cre, else `cre` from PATH
# CRE_GAS_LIMIT=1500000
# CRE_MAX_ATTEMPTS=6              # runs per contest before it is left alone until the gateway restarts
# CRE_RUN_TIMEOUT_MS=240000

# Breaker bot behind the web app's "Run breaker bot" button (OFF unless all three are set). Anyone can
# send USDC to the bot's account and press Run on an open contest; one run at a time, nothing runs on
# its own. The bot finds the contest through GET /.well-known/x402 and pays GATEWAY_PUBLIC_URL over x402.
# BOT_HEDERA_ACCOUNT_ID=0.0.x
# BOT_PRIVATE_KEY=0x...            # secret, ECDSA, USDC associated
# OG_API_KEY_BOT=sk-...            # secret, the attacker model's own 0G Router key
# BOT_MODEL=0gm-1.0-35b-a3b
# BOT_AGENT_ID=                    # the bot's ERC-8004 agent id, sent as X-Agent-Id
# BOT_RUN_MAX_ATTEMPTS=5           # paid messages per run
# BOT_RUN_MAX_PRICE=0.5            # the bot never pays more than this per message
