# Gateway env (build plan §15). The start script also reads ../../.env and ../../../.env, so the shared
# root .env usually covers everything; set gateway-only overrides here. Never commit the real .env.

# Which DefectArena deployment to use: demo (15-min window) or prod (8 h). Addresses come from
# packages/shared/src/deployments.json.
ARENA_DEPLOYMENT=demo

GATEWAY_PORT=8787
# SQLite file lives at $GATEWAY_DATA_DIR/defect.db (persistent volume on Railway)
GATEWAY_DATA_DIR=./data
# Public base URL of this gateway (x402 "resource" URL). Defaults to http://localhost:$GATEWAY_PORT
GATEWAY_PUBLIC_URL=

# Operator: deposits fees, refunds, voids, cancels, closes, posts log hashes; x402 payTo account (secret key)
OPERATOR_PRIVATE_KEY=
OPERATOR_ACCOUNT_ID=

# x402 facilitator (free, no key). Backup: https://api.testnet.blocky402.com
X402_FACILITATOR_URL=https://x402.org/facilitator

# Runner (private service) and its shared bearer token (secret, 32+ chars)
RUNNER_URL=http://127.0.0.1:8788
RUNNER_TOKEN=

# Must match the runner's list
RUNNER_ALLOWED_MODELS=0gm-1.0-35b-a3b

# Canary rounds: 900 in prod, 180 in demo (default follows ARENA_DEPLOYMENT)
CANARY_INTERVAL_SEC=

# Comma-separated origins allowed by CORS (the web app)
WEB_ORIGIN=http://localhost:3000

# Public base URL of the web app, e.g. https://defect.example.com. ERC-8004 feedback writes
# <SITE_URL>/contests/<id> on chain permanently as its endpoint, so it is separate from WEB_ORIGIN.
# Unset: no ERC-8004 feedback is posted (contests are unaffected). Non-https or localhost: posted, with a warning.
SITE_URL=

HEDERA_RPC_URL=https://testnet.hashio.io/api
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# Test-funds faucet (POST /faucet): FAUCET_HBAR once per address (creates the Hedera account for a
# new EVM address), then FAUCET_USDC once the account has enabled USDC. FAUCET_DAILY_CAP counts
# grants (HBAR and USDC each) per rolling 24 h. The faucet key (ECDSA, secret) defaults to the
# operator key; use a separate funded account (e.g. the funder) so faucet spend can't starve the
# operator. It needs HBAR and USDC of its own. FAUCET_ENABLED=false turns it off.
FAUCET_ENABLED=true
FAUCET_PRIVATE_KEY=
FAUCET_HBAR=5
FAUCET_USDC=1
FAUCET_DAILY_CAP=100

# Scripts (seed:demo, send:message)
GATEWAY_URL=http://localhost:8787
WARDEN_DEMO_PRIVATE_KEY=
BREAKER_HUMAN_ACCOUNT_ID=
BREAKER_HUMAN_PRIVATE_KEY=

NODE_ENV=development
