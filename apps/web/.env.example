# Which data source the app uses.
#   mock = built-in fake contests and a fake agent, no backend or wallet funds needed
#   live = real gateway + Hedera contract + x402 payments
NEXT_PUBLIC_DATA_MODE=mock

# --- live mode only ---------------------------------------------------------
# Public URL of apps/gateway (build plan §10)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8787
# Hedera testnet JSON-RPC relay
NEXT_PUBLIC_HEDERA_RPC_URL=https://testnet.hashio.io/api
# Hedera mirror node (account id <-> EVM address, balances)
NEXT_PUBLIC_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
# Sepolia RPC for reading Chainlink CRE attestations (optional)
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Contract addresses come from the gateway's GET /config, so none are needed here.
# WalletConnect (Reown) project id for "Connect wallet" (HashPack, Kabila, Blade, …).
# Create one at https://dashboard.reown.com and add this site's origin to its allowlist.
# Without it, live mode offers only the pasted dev key. Not needed in mock mode.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Privy app id (dashboard.privy.io → your app → App ID) for "Continue with email or Google": an
# embedded wallet whose EVM address becomes the user's Hedera ECDSA account. In the Privy dashboard,
# enable Email and Google logins, and add this site's origin (e.g. http://localhost:3000) to the
# allowed origins. Without it the option is hidden (mock and live mode).
NEXT_PUBLIC_PRIVY_APP_ID=
