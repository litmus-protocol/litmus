# Breaker bot (build plan §12). The bot also reads the repo-level .env (../../.env, ../../../.env).

# Gateway to attack (local default).
GATEWAY_URL=http://localhost:8787

# Hedera testnet JSON-RPC relay, for commit/reveal of a found secret.
HEDERA_RPC_URL=https://testnet.hashio.io/api
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# The DefectArena address is read from the gateway's GET /config, so it always matches the gateway.

# The bot's own Hedera testnet ECDSA account (pays every message itself).
BOT_HEDERA_ACCOUNT_ID=0.0.x
BOT_PRIVATE_KEY=0x...   # secret

# The bot's ERC-8004 agent id. Get it from `register-agent --site <url>`; when set, every message
# carries X-Agent-Id so the gateway links the attempt to the agent's reputation.
# BOT_AGENT_ID=

# Used only by `chat --as human` (fallback terminal chat for a human Breaker, §12.4).
BREAKER_HUMAN_ACCOUNT_ID=0.0.x
BREAKER_HUMAN_PRIVATE_KEY=0x...   # secret

# Attacker model on the 0G Router. A separate key, so the bot's own 0G spend is visible on its own.
OG_ROUTER_BASE_URL=https://router-api.0g.ai/v1
OG_API_KEY_BOT=sk-...   # secret
BOT_MODEL=0gm-1.0-35b-a3b
